# Leave as sikkim_geojson unless PostGIS has been populated with the Sikkim road export.
ROUTE_NETWORK_SOURCE=sikkim_geojson
OSRM_BASE_URL=https://router.project-osrm.org
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
