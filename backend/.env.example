DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
COOKIE_SECURE=false

# Optional live source credentials / product configuration
OPENWEATHER_API_KEY=
NASA_FIRMS_MAP_KEY=
MAPILLARY_ACCESS_TOKEN=
MOSDAC_DATASET_ID=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
